# --- EVCarHUD: board ESP32-2432S028 (ESP32-WROOM-32, flash 4 MB, khong PSRAM) ---
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Bluetooth LE cho Waze Mod (HLP qua GATT): chi BLE (bo Bluetooth thuong de tiet kiem RAM), ngan xep NimBLE,
# chi vai tro ngoai vi, 1 ket noi.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Phai bat vai tro trung tam: tu ESP-IDF 5.5 GATT client (CONFIG_BT_NIMBLE_GATT_CLIENT) chi co khi bat vai tro nay.
# Khong co GATT client thi NimBLE vut chi bao Service Changed (op 0x1d) dien thoai gui luc vua ket noi ma khong xac nhan,
# Android ket o do, khong do duoc dich vu HLP va Waze Mod bao "HLP characteristics missing".
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Khong ghep doi/luu khoa (giong ban P4).
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# LVGL 9: mau 16 bit; font la font tu sinh (vn_font_*.c, speed_font_*.c) nen chi giu font mac dinh cua LVGL.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_FONT_MONTSERRAT_14=y
